# ===========================================================================
# EduRAG Environment Configuration
# ===========================================================================

# 1. Google AI Studio Free Tier (RECOMMENDED for Students - $0.00 Forever)
# Get your free API key in 30 seconds: https://aistudio.google.com/
# Powers both RAG Answer Generation and Scanned Page Vision/Math OCR
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenRouter API (Alternative / Fallback)
# Get free key: https://openrouter.ai/keys
OPEN_ROUTER_API=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# 3. Google Authentication (Google Identity Services)
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin: http://localhost:8000
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# 4. Optional Paths
# VECTOR_DB_PATH=./vector_db
# NOTES_DIR=./notes
