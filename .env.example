# 1. Google AI Studio Free Tier (RECOMMENDED for Students - $0.00 Forever)
# Get your free API key in 30 seconds: https://aistudio.google.com/
# Powers both RAG Answer Generation and Scanned Page Vision/Math OCR
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenRouter API (Alternative / Fallback)
# Get free key: https://openrouter.ai/keys
OPEN_ROUTER_API=your_openrouter_api_key_here
